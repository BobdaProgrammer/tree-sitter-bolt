{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "bolt",
      "camelcase": "Bolt",
      "title": "Bolt",
      "scope": "source.bolt",
      "file-types": [
        "bolt"
      ],
      "injection-regex": "^bolt$",
      "class-name": "TreeSitterBolt"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "Tree sitter for bolt",
    "authors": [
      {
        "name": "BobdaProgrammer",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/BobdaProgrammer/bolt",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": true
  }
}